# Groq API Configuration for Live LLM Generation
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Embedding Engine Mode:
# Set to 1 to use SentenceTransformer with PyTorch (requires PyTorch installed)
# Set to 0 (default) to use the ultra-fast sub-millisecond semantic projection
USE_PYTORCH_EMBED=0

